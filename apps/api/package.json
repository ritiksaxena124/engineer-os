{
  "name": "engineer-os-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bunx tsc -p tsconfig.build.json",
    "start": "bun run dist/main.js",
    "test": "bunx tsc -p tsconfig.test.json && bun test dist-test",
    "test:unit": "bunx tsc -p tsconfig.test.json && bun test dist-test/src",
    "typecheck": "bunx tsc --noEmit",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:deploy": "bunx prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "bunx prisma studio",
    "db:test:prepare": "bun run scripts/prepare-test-db.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "bun-types": "^1.2.15",
    "dotenv": "^16.4.7",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  }
}
