# Control plane
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/engineer_os?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# scrypt work factor: N = 2^factor, memory = 128·N·8 bytes. 15+ for real deployments.
PASSWORD_WORK_FACTOR=14
FRONTEND_ORIGIN=http://localhost:3000

# AI service (mentor / evaluator). Not required for the core engine MVP.
AI_SERVICE_URL=http://localhost:8000
